# Copy this file to .env and fill in your keys
# NEVER commit .env to GitHub

GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
# Supabase is used for AUTH only
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# Comma-separated deployed frontend origins (localhost is always allowed in dev)
FRONTEND_ORIGINS=https://your-app.vercel.app

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_long_random_secret_here
JWT_TTL_HOURS=168

# MongoDB Atlas — application data (users + RFP history)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=proposai
